# Copy this file to .env before using docker compose.
# Never commit your real .env file.

# Required for the Discord bot.
DISCORD_TOKEN=replace-with-discord-bot-token

# Dashboard/admin security.
# Optional emergency compatibility path. Leave empty after account login works.
SDAC_ADMIN_KEY=
SDAC_SECRET_KEY=replace-with-long-random-session-secret

# Optional Cloudflare Turnstile protection for public submission forms.
SDAC_TURNSTILE_SITE_KEY=
SDAC_TURNSTILE_SECRET_KEY=
# Enable only when the dashboard is behind a trusted reverse proxy.
SDAC_TRUST_PROXY=false

# Public dashboard URL used in Discord links and OAuth callbacks.
SANA_PUBLIC_URL=http://localhost:5000
SDAC_PUBLIC_URL=http://localhost:5000
SANA_DASHBOARD_URL=http://localhost:5000

# Discord OAuth login for dashboard/app.
SANA_DISCORD_CLIENT_ID=
SANA_DISCORD_CLIENT_SECRET=
SANA_OAUTH_REDIRECT_URI=
SDAC_DISCORD_CLIENT_ID=
SDAC_DISCORD_CLIENT_SECRET=
SDAC_BOT_CLIENT_ID=

# Optional SMTP provider for private submission and review-status emails.
SANA_SMTP_HOST=
SANA_SMTP_PORT=587
SANA_SMTP_USERNAME=
SANA_SMTP_PASSWORD=
SANA_SMTP_FROM=
SANA_SMTP_FROM_NAME=Sana-Chan
SANA_SMTP_USE_TLS=true
SANA_SMTP_USE_SSL=false

# Local dashboard port.
SANA_DASHBOARD_PORT=5000

# Upload limits.
SDAC_DASHBOARD_MAX_CONTENT_MB=250

# Optional release/update metadata.
SDAC_RELEASE=development
SDAC_RELEASE_TAG=latest-experimental

# Optional PostgreSQL mode.
# Start with: docker compose --profile postgres up -d
# Then set:
# SDAC_DATABASE_URL=postgresql://sana:change-me@postgres:5432/sana
POSTGRES_DB=sana
POSTGRES_USER=sana
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
